{
  "name": "privacy-protocol-scraper",
  "version": "0.1.0",
  "description": "Event scraper for privacy-protocol state distribution",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "scraper": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
